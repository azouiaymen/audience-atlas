# Copy to .env.local for local development. Never commit .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=
# HTTP URL of the FalkorDB Browser, NOT the Redis hostname/port.
FALKORDB_BROWSER_URL=
FALKORDB_TOKEN=
# Alternatively configure database credentials for Browser token generation.
FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_USER=falkordb
FALKORDB_PASSWORD=
FALKORDB_TLS=true
# Optional: running TrueForge server with an OpenAI model configured in Settings.
TRUEFORGE_BASE_URL=
TRUEFORGE_TOKEN=
TRUEFORGE_MODEL=openai/gpt-4.1-mini
